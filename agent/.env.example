# ── Verplicht ───────────────────────────────────────────────
# API-key uit de Trading212-app: Instellingen -> API (Beta) -> Genereer key
# Vink alle lees-scopes aan (account, portfolio, orders, history).
T212_API_KEY=jouw-api-key-hier

# ── Sterk aanbevolen (voor sync naar de Tradr-app) ─────────
# GitHub Personal Access Token met gist-scope (github.com/settings/tokens)
GITHUB_TOKEN=ghp_...
# Laat leeg bij de eerste run: de agent maakt dan zelf een private Gist
# aan en print het ID. Daarna hier invullen.
GIST_ID=

# ── Optioneel (defaults) ───────────────────────────────────
# live = echt account, demo = practice account
T212_ENV=live
# Aantal items historie (orders/dividenden/transacties) per run
HISTORY_LIMIT=50
# true = alleen lokaal opslaan, niet naar Gist pushen
SKIP_GIST=false
# Hoe oud de instrumenten-cache mag worden (dagen) voor verversing
INSTRUMENTS_MAX_AGE_DAYS=7
